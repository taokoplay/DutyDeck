{
  "name": "dutydeck",
  "version": "0.1.1",
  "description": "DutyDeck，为专业用户设计的 Agent",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter='@dutydeck/electron' dev",
    "electron:dev": "bun run --filter='@dutydeck/electron' dev",
    "electron:build": "bun run --filter='@dutydeck/electron' build",
    "electron:start": "bun run --filter='@dutydeck/electron' start",
    "dist:mac": "bun run --filter='@dutydeck/electron' dist:mac",
  "dist:win": "bun run --filter='@dutydeck/electron' dist:win",
  "dist:linux": "bun run --filter='@dutydeck/electron' dist:linux",
    "build": "bun run --filter='*' build",
    "typecheck": "bun run --filter='*' typecheck",
    "test": "bun test",
    "check:deproma": "bun scripts/check-deproma-residue.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dompurify": "^3.4.2",
    "node-gyp": "12.4.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "jotai": "^2.17.1",
    "jotai-family": "^1.1.0"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1"
  },
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@0.99.1": "patches/@earendil-works%2Fpi-coding-agent@0.99.1.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch",
    "@earendil-works/pi-ai@0.99.1": "patches/@earendil-works%2Fpi-ai@0.99.1.patch"
  }
}
