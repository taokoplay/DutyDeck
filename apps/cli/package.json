{
  "name": "@dutydeck/cli",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "dutydeck — DutyDeck 命令行工具。面向有限上下文的 Agent 消费者，提供会话的渐进式读取（list / info / outline / search / export）。",
  "type": "module",
  "bin": {
    "dutydeck": "./src/index.ts",
    "proma": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile dist/dutydeck src/index.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@dutydeck/session-core": "workspace:*",
    "@dutydeck/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
