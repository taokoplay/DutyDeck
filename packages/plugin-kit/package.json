{
  "name": "@dutydeck/plugin-kit",
  "version": "0.1.0",
  "description": "DutyDeck 标准插件脚手架、校验与本地打包工具",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package": { "types": "./dist/package.d.ts", "import": "./dist/package.js" }
  },
  "bin": { "dutydeck-plugin": "./dist/cli.js" },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
